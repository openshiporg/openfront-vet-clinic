  patient                                Patient?                @relation("RabiesCertificate_patient", fields: [patientId], references: [id])
  patientId                              String?                 @map("patient")
  ownerSnapshot                          Json?
  patientSnapshot                        Json?
  vaccineSnapshot                        Json?
  vetSnapshot                            Json?
  vaccinatedOn                           DateTime                @postgresql.Date
  durationMonths                         Int
  nextDueOn                              DateTime                @postgresql.Date
  tagNumber                              String                  @default("")
  tagJurisdiction                        String                  @default("")
  fields                                 Json?
  missingFields                          Json?                   @default("[]")
  document                               ClinicalDocument?       @relation("RabiesCertificate_document", fields: [documentId], references: [id])
  documentId                             String?                 @map("document")
  reportedTo                             String
  reportedAt                             DateTime?
  policyVersions                         Json?
  voidedAt                               DateTime?
  voidReason                             String                  @default("")
  createdAt                              DateTime                @default(now())
  updatedAt                              DateTime                @default(now()) @updatedAt
  from_VaccineAdministration_certificate VaccineAdministration[] @relation("VaccineAdministration_certificate")

  @@index([patientId])
  @@index([documentId])
}

model ReminderType {
  id                               String            @id @default(cuid())
  code                             String            @unique @default("")
  name                             String            @default("")
  kind                             String            @default("vaccine")
  active                           Boolean           @default(true)
  createdAt                        DateTime          @default(now())
  updatedAt                        DateTime          @default(now()) @updatedAt
  from_VaccineProduct_reminderType VaccineProduct[]  @relation("VaccineProduct_reminderType")
  from_ReminderRule_satisfies      ReminderRule[]    @relation("ReminderRule_satisfies")
  from_PatientReminder_type        PatientReminder[] @relation("PatientReminder_type")
}

model ReminderProtocol {
  id        String                    @id @default(cuid())
  code      String                    @unique @default("")
  name      String                    @default("")
  species   Species?                  @relation("ReminderProtocol_species", fields: [speciesId], references: [id])
  speciesId String?                   @map("species")
  versions  ReminderProtocolVersion[] @relation("ReminderProtocolVersion_protocol")
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @default(now()) @updatedAt

  @@index([speciesId])
}

model ReminderProtocolVersion {
  id                                   String            @id @default(cuid())
  protocol                             ReminderProtocol? @relation("ReminderProtocolVersion_protocol", fields: [protocolId], references: [id])
  protocolId                           String?           @map("protocol")
  label                                String            @default("")
  versionNumber                        Int
  rules                                ReminderRule[]    @relation("ReminderRule_protocolVersion")
  sourceRefs                           Json?
  verified                             Boolean           @default(false)
  unverifiedRules                      Json?             @default("[]")
  status                               String            @default("draft")
  publishedAt                          DateTime?
  contentHash                          String            @default("")
  version                              Int               @default(0)
  createdAt                            DateTime          @default(now())
  updatedAt                            DateTime          @default(now()) @updatedAt
  from_PatientReminder_protocolVersion PatientReminder[] @relation("PatientReminder_protocolVersion")

  @@unique([protocolId, versionNumber], map: "ReminderProtocolVersion_protocol_number_key")
  @@index([protocolId])
}

model ReminderRule {
  id                        String                   @id @default(cuid())
  protocolVersion           ReminderProtocolVersion? @relation("ReminderRule_protocolVersion", fields: [protocolVersionId], references: [id])
  protocolVersionId         String?                  @map("protocolVersion")
  code                      String                   @default("")
  triggerVaccines           VaccineProduct[]         @relation("ReminderRule_triggerVaccines")
  triggerServiceCode        String                   @default("")
  satisfies                 ReminderType?            @relation("ReminderRule_satisfies", fields: [satisfiesId], references: [id])
  satisfiesId               String?                  @map("satisfies")
  schedule                  Json?
  leadDays                  Int?                     @default(30)
  graceDays                 Int?                     @default(30)
  lapseDays                 Int?                     @default(180)
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @default(now()) @updatedAt
  from_PatientReminder_rule PatientReminder[]        @relation("PatientReminder_rule")

  @@index([protocolVersionId])
  @@index([satisfiesId])
}

model PatientReminder {
  id                String                   @id @default(cuid())
  patient           Patient?                 @relation("PatientReminder_patient", fields: [patientId], references: [id])
  patientId         String?                  @map("patient")
  location          Location?                @relation("PatientReminder_location", fields: [locationId], references: [id])
  locationId        String?                  @map("location")
  type              ReminderType?            @relation("PatientReminder_type", fields: [typeId], references: [id])
  typeId            String?                  @map("type")
  rule              ReminderRule?            @relation("PatientReminder_rule", fields: [ruleId], references: [id])
  ruleId            String?                  @map("rule")
  dueOn             DateTime                 @postgresql.Date
  status            String                   @default("scheduled")
  suppressedReason  String                   @default("")
  protocolVersion   ReminderProtocolVersion? @relation("PatientReminder_protocolVersion", fields: [protocolVersionId], references: [id])
  protocolVersionId String?                  @map("protocolVersion")
  source            String
  sourceKey         String                   @default("")
  lastNotifiedAt    DateTime?
  satisfactions     ReminderSatisfaction[]   @relation("ReminderSatisfaction_reminder")
  version           Int                      @default(0)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @default(now()) @updatedAt

  @@unique([patientId, typeId, dueOn], map: "PatientReminder_patient_type_due_key")
  @@index([patientId])
  @@index([locationId])
  @@index([typeId])
  @@index([ruleId])
  @@index([protocolVersionId])
}

model ReminderSatisfaction {
  id                      String                 @id @default(cuid())
  reminder                PatientReminder?       @relation("ReminderSatisfaction_reminder", fields: [reminderId], references: [id])
  reminderId              String?                @map("reminder")
  sourceKey               String                 @default("")
  vaccineAdministration   VaccineAdministration? @relation("ReminderSatisfaction_vaccineAdministration", fields: [vaccineAdministrationId], references: [id])
  vaccineAdministrationId String?                @map("vaccineAdministration")
  administration          Administration?        @relation("ReminderSatisfaction_administration", fields: [administrationId], references: [id])
  administrationId        String?                @map("administration")
  externalEvidence        Document?              @relation("ReminderSatisfaction_externalEvidence", fields: [externalEvidenceId], references: [id])
  externalEvidenceId      String?                @map("externalEvidence")
  note                    String                 @default("")
  recordedBy              StaffMember?           @relation("ReminderSatisfaction_recordedBy", fields: [recordedById], references: [id])
  recordedById            String?                @map("recordedBy")
  at                      DateTime

  @@unique([reminderId, sourceKey], map: "ReminderSatisfaction_reminder_source_key")
  @@index([reminderId])
  @@index([vaccineAdministrationId])
  @@index([administrationId])
  @@index([externalEvidenceId])
  @@index([recordedById])
}

model AdverseEventReport {
  id                      String                 @id @default(cuid())
  patient                 Patient?               @relation("AdverseEventReport_patient", fields: [patientId], references: [id])
  patientId               String?                @map("patient")
  vaccineAdministration   VaccineAdministration? @relation("AdverseEventReport_vaccineAdministration", fields: [vaccineAdministrationId], references: [id])
  vaccineAdministrationId String?                @map("vaccineAdministration")
  administration          Administration?        @relation("AdverseEventReport_administration", fields: [administrationId], references: [id])
  administrationId        String?                @map("administration")
  product                 VaccineProduct?        @relation("AdverseEventReport_product", fields: [productId], references: [id])
  productId               String?                @map("product")
  drug                    DrugProduct?           @relation("AdverseEventReport_drug", fields: [drugId], references: [id])
  drugId                  String?                @map("drug")
  lotNumber               String                 @default("")
  description             String                 @default("")
  severity                String
  reportedTo              String
  status                  String                 @default("draft")
  reference               String                 @default("")
  submittedAt             DateTime?
  createdBy               StaffMember?           @relation("AdverseEventReport_createdBy", fields: [createdById], references: [id])
  createdById             String?                @map("createdBy")
  version                 Int                    @default(0)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @default(now()) @updatedAt

  @@index([patientId])
  @@index([vaccineAdministrationId])
  @@index([administrationId])
  @@index([productId])
  @@index([drugId])
  @@index([createdById])
}

model ImportBatch {
  id          String      @id @default(cuid())
  ref         String      @unique @default("")
  system      String
  channel     String
  entity      String
  location    Location?   @relation("ImportBatch_location", fields: [locationId], references: [id])
  locationId  String?     @map("location")
  fileName    String      @default("")
  fileHash    String      @default("")
  status      String      @default("received")
  rowsTotal   Int?        @default(0)
  rowsCreated Int?        @default(0)
  rowsSkipped Int?        @default(0)
  rowsFailed  Int?        @default(0)
  mapping     Json?
  startedBy   User?       @relation("ImportBatch_startedBy", fields: [startedById], references: [id])
  startedById String?     @map("startedBy")
  finishedAt  DateTime?
  rows        ImportRow[] @relation("ImportRow_batch")
  version     Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt

  @@index([locationId])
  @@index([fileHash])
  @@index([startedById])
}

model ImportRow {
  id         String       @id @default(cuid())
  batch      ImportBatch? @relation("ImportRow_batch", fields: [batchId], references: [id])
  batchId    String?      @map("batch")
  rowNumber  Int
  externalId String       @default("")
  result     String
  recordType String       @default("")
  recordId   String       @default("")
  errors     Json?        @default("[]")
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @default(now()) @updatedAt

  @@unique([batchId, rowNumber], map: "ImportRow_batch_row_key")
  @@index([batchId])
}

model AgentToolGrant {
  id          String           @id @default(cuid())
  agent       AgentIdentity?   @relation("AgentToolGrant_agent", fields: [agentId], references: [id])
  agentId     String?          @map("agent")
  scope       String
  constraints Json?
  status      String           @default("requested")
  approval    ApprovalRequest? @relation("AgentToolGrant_approval", fields: [approvalId], references: [id])
  approvalId  String?          @map("approval")
  revokedAt   DateTime?
  version     Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt

  @@index([agentId])
  @@index([approvalId])
}

model AgentRun {
  id                       String         @id @default(cuid())
  agent                    AgentIdentity? @relation("AgentRun_agent", fields: [agentId], references: [id])
  agentId                  String?        @map("agent")
  startedAt                DateTime?      @default(now())
  endedAt                  DateTime?
  status                   String         @default("started")
  promptHash               String         @default("")
  toolCalls                Json?
  costMeta                 Json?
  callRecordId             String         @default("")
  proposals                Proposal[]     @relation("Proposal_agentRun")
  version                  Int            @default(0)
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @default(now()) @updatedAt
  from_CallRecord_agentRun CallRecord[]   @relation("CallRecord_agentRun")
  from_AgentAction_run     AgentAction[]  @relation("AgentAction_run")

  @@index([agentId])
  @@index([callRecordId])
}

model AgentAction {
  id           String         @id @default(cuid())
  agent        AgentIdentity? @relation("AgentAction_agent", fields: [agentId], references: [id])
  agentId      String?        @map("agent")
  run          AgentRun?      @relation("AgentAction_run", fields: [runId], references: [id])
  runId        String?        @map("run")
  tool         String         @default("")
  argsHash     String         @default("")
  outcome      String
  errorCode    String         @default("")
  auditEventId String         @default("")
  at           DateTime?      @default(now())

  @@index([agentId])
  @@index([runId])
  @@index([tool])
}

model Proposal {
  id                String           @id @default(cuid())
  kind              String
  payload           Json?
  payloadHash       String           @default("")
  status            String           @default("proposed")
  agentRun          AgentRun?        @relation("Proposal_agentRun", fields: [agentRunId], references: [id])
  agentRunId        String?          @map("agentRun")
  proposedByAgent   AgentIdentity?   @relation("Proposal_proposedByAgent", fields: [proposedByAgentId], references: [id])
  proposedByAgentId String?          @map("proposedByAgent")
  proposedByUser    User?            @relation("Proposal_proposedByUser", fields: [proposedByUserId], references: [id])
  proposedByUserId  String?          @map("proposedByUser")
  targetList        String           @default("")
  targetId          String           @default("")
  approval          ApprovalRequest? @relation("Proposal_approval", fields: [approvalId], references: [id])
  approvalId        String?          @map("approval")
  validation        Json?
  version           Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @default(now()) @updatedAt

  @@index([agentRunId])
  @@index([proposedByAgentId])
  @@index([proposedByUserId])
  @@index([targetId])
  @@index([approvalId])
}

enum UserKindType {
  staff
  relief
  auditor
  administrator
}
