  currencyCode                 String       @default("USD")
  medicalDirector              StaffMember? @relation("PracticeSettings_medicalDirector", fields: [medicalDirectorId], references: [id])
  medicalDirectorId            String?      @map("medicalDirector")
  estimateValidityDays         Int?         @default(30)
  estimateOverageToleranceBps  Int?         @default(0)
  electiveDepositPct           Decimal?     @postgresql.Decimal(12, 6)
  depositBasis                 String       @default("low")
  noShowGraceMinutes           Int?         @default(15)
  unsignedRecordTaskHours      Int?         @default(24)
  unsignedRecordEscalateHours  Int?         @default(72)
  refundApprovalThresholdMinor BigInt       @default(25000)
  discountApprovalThresholdBps Int?         @default(1000)
  writeOffRequiresApproval     Boolean      @default(true)
  weightMaxAgeHours            Json?        @default("{\"anaesthesia\":24,\"inpatient\":72,\"outpatient\":720}")
  features                     Json?        @default("{\"boarding\":true,\"grooming\":true,\"wellnessPlans\":true,\"insurance\":true,\"aiVoice\":false,\"scribe\":false,\"multiLocation\":true,\"pdmp\":true,\"csos\":false,\"drugCabinet\":false}")
  strictAgentOwnerSoD          Boolean      @default(true)
  onboardingStatus             String       @default("not_started")
  version                      Int          @default(0)
  createdAt                    DateTime     @default(now())
  updatedAt                    DateTime     @default(now()) @updatedAt

  @@index([medicalDirectorId])
}

model ProfessionalLicense {
  id                             String              @id @default(cuid())
  staffMember                    StaffMember?        @relation("ProfessionalLicense_staffMember", fields: [staffMemberId], references: [id])
  staffMemberId                  String?             @map("staffMember")
  kind                           String
  stateCode                      String              @default("")
  licenseNumber                  String              @default("")
  issuedOn                       DateTime?           @postgresql.Date
  expiresOn                      DateTime            @postgresql.Date
  status                         String              @default("active")
  verifiedAt                     DateTime?
  verifiedBy                     User?               @relation("ProfessionalLicense_verifiedBy", fields: [verifiedById], references: [id])
  verifiedById                   String?             @map("verifiedBy")
  verificationSource             String              @default("")
  version                        Int                 @default(0)
  createdAt                      DateTime            @default(now())
  updatedAt                      DateTime            @default(now()) @updatedAt
  from_LicenseEvaluation_license LicenseEvaluation[] @relation("LicenseEvaluation_license")

  @@unique([stateCode, kind, licenseNumber], map: "ProfessionalLicense_state_kind_number_key")
  @@index([staffMemberId])
  @@index([verifiedById])
}

model StaffMember {
  id                                    String                @id @default(cuid())
  user                                  User?                 @relation("StaffMember_user", fields: [userId], references: [id])
  userId                                String?               @unique @map("user")
  displayName                           String                @default("")
  kind                                  String                @default("dvm")
  credentials                           String                @default("")
  employment                            String                @default("employee")
  homeLocation                          Location?             @relation("StaffMember_homeLocation", fields: [homeLocationId], references: [id])
  homeLocationId                        String?               @map("homeLocation")
  locations                             Location[]            @relation("StaffMember_locations")
  colour                                String                @default("")
  licenses                              ProfessionalLicense[] @relation("ProfessionalLicense_staffMember")
  active                                Boolean               @default(true)
  createdAt                             DateTime              @default(now())
  updatedAt                             DateTime              @default(now()) @updatedAt
  from_DeaPowerOfAttorney_grantee       DeaPowerOfAttorney[]  @relation("DeaPowerOfAttorney_grantee")
  from_DeaRegistration_staffMember      DeaRegistration[]     @relation("DeaRegistration_staffMember")
  from_LicenseEvaluation_staffMember    LicenseEvaluation[]   @relation("LicenseEvaluation_staffMember")
  from_PracticeSettings_medicalDirector PracticeSettings[]    @relation("PracticeSettings_medicalDirector")
  from_Task_assignee                    Task[]                @relation("Task_assignee")

