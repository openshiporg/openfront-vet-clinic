model PolicyBinding {
  id         String      @id @default(cuid())
  pack       PolicyPack? @relation("PolicyBinding_pack", fields: [packId], references: [id])
  packId     String?     @map("pack")
  scope      String
  location   Location?   @relation("PolicyBinding_location", fields: [locationId], references: [id])
  locationId String?     @map("location")
  layer      String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @default(now()) @updatedAt

  @@unique([packId, scope, locationId], map: "PolicyBinding_pack_scope_location_key")
  @@index([packId])
  @@index([locationId])
}

model PolicyPack {
  id                      String          @id @default(cuid())
  code                    String          @unique @default("")
  name                    String          @default("")
  kind                    String
  jurisdiction            String          @default("")
  versions                PolicyVersion[] @relation("PolicyVersion_pack")
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @default(now()) @updatedAt
  from_PolicyBinding_pack PolicyBinding[] @relation("PolicyBinding_pack")

  @@index([jurisdiction])
}

model PolicyVersion {
  id                                 String            @id @default(cuid())
  pack                               PolicyPack?       @relation("PolicyVersion_pack", fields: [packId], references: [id])
  packId                             String?           @map("pack")
  label                              String            @default("")
  versionNumber                      Int
  rules                              Json?
  rulesHash                          String            @default("")
  sourceRefs                         Json?
  verified                           Boolean           @default(false)
  unverifiedRules                    Json?
  verifiedAt                         DateTime?
  effectiveFrom                      DateTime          @postgresql.Date
  effectiveTo                        DateTime?         @postgresql.Date
  status                             String            @default("draft")
  approval                           ApprovalRequest?  @relation("PolicyVersion_approval", fields: [approvalId], references: [id])
  approvalId                         String?           @map("approval")
  publishedAt                        DateTime?
  publishedBy                        User?             @relation("PolicyVersion_publishedBy", fields: [publishedById], references: [id])
  publishedById                      String?           @map("publishedBy")
  version                            Int               @default(0)
  createdAt                          DateTime          @default(now())
  updatedAt                          DateTime          @default(now()) @updatedAt
  from_ComplianceTask_policyVersion  ComplianceTask[]  @relation("ComplianceTask_policyVersion")
  from_RetentionPolicy_policyVersion RetentionPolicy[] @relation("RetentionPolicy_policyVersion")

  @@unique([packId, versionNumber], map: "PolicyVersion_pack_number_key")
  @@index([packId])
  @@index([approvalId])
  @@index([publishedById])
}

model RetentionPolicy {
