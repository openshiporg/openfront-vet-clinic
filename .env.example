# Copy to .env and fill in. Never commit real values.
DATABASE_URL=postgresql://user:password@localhost:5432/openfront_vet_clinic
# Prisma's shadow database for `npm run migrate:gen` (development only).
SHADOW_DATABASE_URL=postgresql://user:password@localhost:5432/openfront_vet_clinic_shadow
# At least 32 random characters.
SESSION_SECRET=
PUBLIC_SIGNUPS_ALLOWED=false

# AI assistant (dashboard chat) through OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_MAX_TOKENS=

# Outgoing email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STORE_LINK=

# Database tests only: a disposable schema named "vitest". Pass inline; never point at real data.
# VC_TEST_DATABASE_URL=postgresql://user:password@localhost:5432/openfront_vet_clinic?schema=vitest

# Scheduler → POST /api/jobs/comms (outbox: texts, reminders, document rendering) and
# POST /api/jobs/clinical (treatment sheets, unsigned records, daily reminders), each with
# "Authorization: Bearer $JOBS_SECRET", every 5–15 minutes.
JOBS_SECRET=
# SMS (optional; without them texts are handed to the front desk as tasks)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# The public URL Twilio posts inbound SMS to (signature validation uses it)
TWILIO_WEBHOOK_URL=

# Ambient scribe (optional; without them the clinician pastes the conversation and edits the draft).
# Speech-to-text: any OpenAI-compatible /audio/transcriptions endpoint (self-hosted Whisper works).
SCRIBE_STT_URL=
SCRIBE_STT_API_KEY=
SCRIBE_STT_MODEL=
# Drafting model: any OpenAI-compatible /chat/completions endpoint (OpenRouter, vLLM, Ollama).
SCRIBE_LLM_URL=
SCRIBE_LLM_API_KEY=
SCRIBE_LLM_MODEL=

# PIMS import (optional; without them staff upload Avimark / ezyVet / Cornerstone CSV exports).
# ezyVet partner API (OAuth client credentials). Partner access is granted by ezyVet.
EZYVET_API_URL=
EZYVET_PARTNER_ID=
EZYVET_CLIENT_ID=
EZYVET_CLIENT_SECRET=
EZYVET_SITE_UID=
